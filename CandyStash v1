<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#0b1020">
  <meta name="description" content="Candy Stash — searchable game file collection.">
  <title>Candy Stash</title>

  <style>
    :root {
      --bg: #070a12;
      --bg-2: #0d1322;
      --surface: rgba(17, 23, 38, .76);
      --surface-2: rgba(21, 29, 47, .92);
      --surface-hover: rgba(30, 42, 68, .96);
      --line: rgba(255,255,255,.09);
      --line-hover: rgba(137,174,255,.32);
      --text: #f7f9ff;
      --muted: #8f9cb5;
      --accent: #78a7ff;
      --accent-2: #9d7cff;
      --accent-soft: rgba(120,167,255,.14);
      --radius: 18px;
      --sidebar: 78px;
      --sidebar-open: 222px;
      --max: 1180px;
      --ease: 180ms cubic-bezier(.2,.75,.2,1);
    }

    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      min-height: 100vh;
      color: var(--text);
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
                   "Segoe UI", sans-serif;
      background:
        radial-gradient(1000px 650px at 5% -5%, rgba(70,105,215,.20), transparent 62%),
        radial-gradient(900px 650px at 100% 100%, rgba(125,75,205,.16), transparent 62%),
        linear-gradient(145deg, var(--bg), var(--bg-2));
      overflow-x: hidden;
    }

    button, input { font: inherit; }
    button { -webkit-tap-highlight-color: transparent; }
    a { color: inherit; }
    :focus-visible {
      outline: 3px solid rgba(120,167,255,.65);
      outline-offset: 3px;
    }

    #particleCanvas {
      position: fixed;
      inset: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      z-index: -1;
      opacity: .34;
    }

    /* Launcher sidebar */
    .sidebar {
      position: fixed;
      inset: 0 auto 0 0;
      z-index: 1000;
      width: var(--sidebar);
      padding: 12px 10px;
      display: flex;
      flex-direction: column;
      gap: 9px;
      overflow-x: hidden;
      overflow-y: auto;
      background: rgba(6,10,19,.78);
      border-right: 1px solid var(--line);
      backdrop-filter: blur(18px) saturate(125%);
      -webkit-backdrop-filter: blur(18px) saturate(125%);
      box-shadow: 12px 0 40px rgba(0,0,0,.22);
      transition: width var(--ease);
    }
    .sidebar.expanded { width: var(--sidebar-open); }

    .sidebar-top {
      display: flex;
      align-items: center;
      gap: 9px;
      margin-bottom: 6px;
    }

    .sidebar-toggle {
      width: 58px;
      min-width: 58px;
      height: 44px;
      border: 1px solid var(--line);
      border-radius: 13px;
      background: rgba(255,255,255,.055);
      color: white;
      cursor: pointer;
      font-size: 20px;
      transition: transform var(--ease), background var(--ease), border-color var(--ease);
    }
    .sidebar-toggle:hover {
      transform: translateY(-1px);
      background: rgba(255,255,255,.10);
      border-color: var(--line-hover);
    }

    .sidebar-title {
      color: var(--muted);
      font-size: 11px;
      font-weight: 850;
      letter-spacing: 1.3px;
      white-space: nowrap;
      opacity: 0;
      transform: translateX(-5px);
      transition: opacity var(--ease), transform var(--ease);
    }
    .sidebar.expanded .sidebar-title { opacity: 1; transform: none; }

    .sidebar-btn {
      position: relative;
      width: 100%;
      min-height: 45px;
      flex: 0 0 auto;
      border: 1px solid rgba(255,255,255,.07);
      border-radius: 13px;
      background: linear-gradient(145deg, #567fcf, #385997);
      color: white;
      font-weight: 900;
      cursor: pointer;
      box-shadow: 0 5px 15px rgba(0,0,0,.20), inset 0 1px rgba(255,255,255,.12);
      transition: transform var(--ease), box-shadow var(--ease), filter var(--ease);
    }
    .sidebar-btn:hover {
      transform: translateY(-2px);
      filter: brightness(1.08);
      box-shadow: 0 10px 23px rgba(52,93,177,.28);
    }
    .sidebar-btn.active {
      box-shadow: 0 0 0 2px rgba(137,174,255,.30), 0 0 22px rgba(89,132,225,.24);
    }
    .sidebar-btn.empty { opacity: .20; cursor: default; }
    .sidebar-btn.empty:hover { transform: none; filter: none; }

    .sidebar:not(.expanded) .sidebar-btn::after {
      content: attr(data-tooltip);
      position: absolute;
      left: calc(100% + 12px);
      top: 50%;
      transform: translate(-5px,-50%);
      opacity: 0;
      pointer-events: none;
      padding: 7px 10px;
      border: 1px solid var(--line);
      border-radius: 9px;
      background: rgba(7,10,18,.97);
      color: white;
      font-size: 12px;
      font-weight: 650;
      white-space: nowrap;
      box-shadow: 0 12px 30px rgba(0,0,0,.34);
      transition: opacity var(--ease), transform var(--ease);
    }
    .sidebar:not(.expanded) .sidebar-btn:hover::after {
      opacity: 1;
      transform: translate(0,-50%);
    }

    .sidebar::-webkit-scrollbar { width: 5px; }
    .sidebar::-webkit-scrollbar-thumb {
      background: rgba(255,255,255,.15);
      border-radius: 999px;
    }

    /* Main launcher */
    .main-content {
      min-height: 100vh;
      margin-left: var(--sidebar);
      padding: 30px 30px 90px;
      transition: margin-left var(--ease);
    }
    .sidebar.expanded ~ .main-content { margin-left: var(--sidebar-open); }
    .content-wrapper { width: min(100%, var(--max)); margin: 0 auto; }

    .hero {
      position: relative;
      min-height: 255px;
      margin-bottom: 20px;
      padding: 38px 40px;
      display: flex;
      align-items: flex-end;
      overflow: hidden;
      border: 1px solid var(--line);
      border-radius: 24px;
      background:
        radial-gradient(circle at 82% 25%, rgba(120,167,255,.20), transparent 30%),
        radial-gradient(circle at 65% 85%, rgba(157,124,255,.13), transparent 32%),
        linear-gradient(120deg, rgba(19,27,46,.94), rgba(10,15,27,.72));
      box-shadow: 0 25px 65px rgba(0,0,0,.24);
    }
    .hero::before {
      content: "";
      position: absolute;
      inset: auto -15% -65% 40%;
      height: 240px;
      background: radial-gradient(ellipse, rgba(116,157,255,.16), transparent 65%);
      transform: rotate(-7deg);
      pointer-events: none;
    }
    .hero::after {
      content: "";
      position: absolute;
      top: 0;
      right: 0;
      width: 45%;
      height: 100%;
      opacity: .35;
      background:
        linear-gradient(135deg, transparent 30%, rgba(255,255,255,.025) 30% 31%, transparent 31% 60%, rgba(255,255,255,.018) 60% 61%, transparent 61%);
      pointer-events: none;
    }

    .hero-copy { position: relative; z-index: 1; max-width: 720px; }
    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 12px;
      padding: 6px 10px;
      border: 1px solid var(--line);
      border-radius: 999px;
      background: rgba(255,255,255,.045);
      color: #bfcef0;
      font-size: 10px;
      font-weight: 900;
      letter-spacing: 1.1px;
      text-transform: uppercase;
    }
    .eyebrow::before {
      content: "";
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--accent);
      box-shadow: 0 0 12px var(--accent);
    }

    h1 {
      margin: 0;
      font-size: clamp(42px, 6vw, 70px);
      line-height: .92;
      letter-spacing: -3px;
      font-weight: 950;
      text-shadow: 0 9px 40px rgba(0,0,0,.42);
    }
    .subtitle {
      margin: 15px 0 0;
      max-width: 660px;
      color: var(--muted);
      font-size: 14px;
      line-height: 1.55;
    }
    .subtitle a, .info-link {
      color: #b1caff;
      text-decoration: none;
      font-weight: 800;
    }
    .subtitle a:hover, .info-link:hover { text-decoration: underline; }

    .info-links {
      display: flex;
      align-items: center;
      gap: 9px;
      margin: 0 4px 18px;
      color: var(--muted);
      font-size: 12px;
    }

    /* Search / library toolbar */
    .toolbar {
      position: sticky;
      top: 10px;
      z-index: 80;
      margin-bottom: 25px;
      padding: 9px;
      display: flex;
      align-items: center;
      gap: 9px;
      border: 1px solid var(--line);
      border-radius: 17px;
      background: rgba(9,14,25,.82);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
      box-shadow: 0 16px 42px rgba(0,0,0,.24);
    }
    .search-box {
      position: relative;
      flex: 1;
    }
    #searchInput {
      width: 100%;
      height: 50px;
      padding: 0 48px 0 17px;
      border: 1px solid transparent;
      border-radius: 12px;
      outline: none;
      color: white;
      background: rgba(255,255,255,.055);
      transition: border-color var(--ease), background var(--ease), box-shadow var(--ease);
    }
    #searchInput::placeholder { color: #73809a; }
    #searchInput:focus {
      border-color: rgba(120,167,255,.45);
      background: rgba(255,255,255,.075);
      box-shadow: 0 0 0 4px rgba(120,167,255,.09);
    }
    .clear-search {
      position: absolute;
      right: 8px;
      top: 7px;
      width: 36px;
      height: 36px;
      border: 0;
      border-radius: 9px;
      background: transparent;
      color: var(--muted);
      cursor: pointer;
      opacity: 0;
      pointer-events: none;
    }
    .clear-search.visible { opacity: 1; pointer-events: auto; }
    .clear-search:hover { background: rgba(255,255,255,.08); color: white; }

    #lolbutton {
      min-width: 132px;
      height: 50px;
      padding: 0 14px;
      border: 1px solid var(--line);
      border-radius: 12px;
      background: var(--accent-soft);
      color: #cbd9ff;
      font-size: 12px;
      font-weight: 850;
      cursor: pointer;
      transition: transform var(--ease), background var(--ease), color var(--ease);
    }
    #lolbutton:hover {
      transform: translateY(-1px);
      background: rgba(120,167,255,.23);
      color: white;
    }
    #lolbutton:disabled { cursor: wait; opacity: .62; }

    .status {
      position: absolute;
      left: 12px;
      bottom: -20px;
      color: var(--muted);
      font-size: 11px;
    }

    /* Library sections */
    .letter-section {
      width: 100%;
      margin: 0 auto 42px;
      scroll-margin-top: 88px;
    }
    .letter-header {
      display: flex;
      align-items: center;
      gap: 12px;
      margin: 0 0 14px;
      padding: 0 4px 11px;
      border-bottom: 1px solid var(--line);
      font-size: 26px;
      font-weight: 950;
      letter-spacing: -.8px;
    }
    .letter-header::after {
      content: "";
      flex: 1;
      height: 1px;
      background: linear-gradient(90deg, rgba(120,167,255,.35), transparent);
    }

    .buttons-container {
      display: grid;
      grid-template-columns: repeat(2, minmax(0,1fr));
      gap: 12px;
    }

    /* Turn existing generated input buttons into library cards. */
    input[type="button"] {
      width: 100%;
      min-height: 78px;
      padding: 17px 18px 17px 21px;
      position: relative;
      overflow: hidden;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      color: #f5f8ff;
      background:
        radial-gradient(220px 90px at 100% 0%, rgba(120,167,255,.13), transparent 65%),
        linear-gradient(145deg, rgba(27,38,62,.96), rgba(14,20,34,.96));
      font-size: 14px;
      font-weight: 720;
      line-height: 1.35;
      text-align: left;
      cursor: pointer;
      box-shadow: 0 7px 18px rgba(0,0,0,.15);
      transition: transform var(--ease), border-color var(--ease), background var(--ease),
                  box-shadow var(--ease);
    }
    input[type="button"]::before {
      content: "▶";
      position: absolute;
      right: 17px;
      top: 50%;
      width: 31px;
      height: 31px;
      display: grid;
      place-items: center;
      transform: translateY(-50%);
      border: 1px solid rgba(255,255,255,.08);
      border-radius: 9px;
      color: #bcd1ff;
      background: rgba(120,167,255,.09);
      font-size: 10px;
      opacity: .7;
      transition: transform var(--ease), background var(--ease), opacity var(--ease);
    }
    input[type="button"]::after {
      content: "";
      position: absolute;
      left: 0;
      top: 0;
      bottom: 0;
      width: 3px;
      background: linear-gradient(180deg, var(--accent), var(--accent-2));
      opacity: .35;
    }
    input[type="button"]:hover {
      transform: translateY(-3px);
      border-color: var(--line-hover);
      background:
        radial-gradient(260px 110px at 100% 0%, rgba(120,167,255,.18), transparent 65%),
        linear-gradient(145deg, rgba(31,45,74,.98), rgba(16,24,41,.98));
      box-shadow: 0 14px 30px rgba(0,0,0,.25);
    }
    input[type="button"]:hover::before {
      opacity: 1;
      transform: translateY(-50%) scale(1.06);
      background: rgba(120,167,255,.18);
    }
    input[type="button"]:active { transform: translateY(-1px); }

    .empty-message {
      padding: 22px;
      border: 1px dashed var(--line);
      border-radius: 14px;
      color: var(--muted);
      text-align: center;
      font-size: 13px;
    }

    ::selection { background: rgba(120,167,255,.34); color: white; }

    @media (max-width: 820px) {
      .buttons-container { grid-template-columns: 1fr; }
      .hero { min-height: 225px; padding: 30px; }
    }

    @media (max-width: 700px) {
      :root { --sidebar: 58px; --sidebar-open: 182px; }
      .main-content { padding: 20px 14px 70px; }
      .hero { border-radius: 20px; }
      .toolbar { top: 7px; }
      #lolbutton { min-width: 105px; }
    }

    @media (max-width: 480px) {
      :root { --sidebar: 48px; --sidebar-open: 158px; }
      .sidebar { padding: 9px 5px; }
      .sidebar-toggle { width: 38px; min-width: 38px; height: 38px; }
      .main-content { padding: 14px 9px 55px; }
      .hero { min-height: 205px; padding: 25px 21px; }
      h1 { font-size: 39px; letter-spacing: -2px; }
      .subtitle { font-size: 13px; }
      .toolbar { padding: 7px; }
      #searchInput, #lolbutton { height: 46px; }
      #lolbutton { min-width: 92px; padding: 0 9px; }
      .letter-header { font-size: 22px; }
      input[type="button"] { min-height: 70px; font-size: 13px; }
    }

    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto; }
      *, *::before, *::after {
        animation-duration: .01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: .01ms !important;
      }
      #particleCanvas { display: none; }
    }
  
/* Candy Stash theme system */
:root {
  color-scheme: dark;
  --theme-bg: #080a12;
  --theme-bg-2: #10142a;
  --theme-panel: rgba(20, 24, 42, .72);
  --theme-panel-strong: rgba(25, 29, 50, .9);
  --theme-text: #f5f7ff;
  --theme-muted: #a9b1cc;
  --theme-border: rgba(255,255,255,.10);
  --theme-shadow: rgba(0,0,0,.30);
  --theme-accent: #8b7cff;
  --theme-accent-2: #b46cff;
}
html[data-theme="light"] {
  color-scheme: light;
  --theme-bg: #eef1f8;
  --theme-bg-2: #f9faff;
  --theme-panel: rgba(255,255,255,.78);
  --theme-panel-strong: rgba(255,255,255,.94);
  --theme-text: #171a28;
  --theme-muted: #626a80;
  --theme-border: rgba(30,36,60,.12);
  --theme-shadow: rgba(48,55,85,.16);
  --theme-accent: #6657e8;
  --theme-accent-2: #9b4fe7;
}
body {
  background:
    radial-gradient(circle at 15% 10%, color-mix(in srgb, var(--theme-accent) 18%, transparent), transparent 32%),
    radial-gradient(circle at 85% 15%, color-mix(in srgb, var(--theme-accent-2) 15%, transparent), transparent 30%),
    linear-gradient(135deg, var(--theme-bg), var(--theme-bg-2));
  color: var(--theme-text);
}
.sidebar, .hero, .toolbar, .library, .card, .search-wrap {
  border-color: var(--theme-border) !important;
  box-shadow: 0 18px 50px var(--theme-shadow);
}
.sidebar, .hero, .toolbar, .library, .card, .search-wrap {
  background-color: var(--theme-panel);
}
.theme-toggle {
  width: 100%;
  margin-top: 10px;
  padding: 11px 13px;
  border: 1px solid var(--theme-border);
  border-radius: 12px;
  background: var(--theme-panel-strong);
  color: var(--theme-text);
  font: inherit;
  font-weight: 700;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 9px;
  transition: transform .18s ease, border-color .18s ease, background .18s ease;
}
.theme-toggle:hover {
  transform: translateY(-1px);
  border-color: color-mix(in srgb, var(--theme-accent) 55%, var(--theme-border));
}
.theme-toggle:focus-visible {
  outline: 2px solid var(--theme-accent);
  outline-offset: 3px;
}
.theme-icon { font-size: 1.05em; }
.theme-label { white-space: nowrap; }
input[type="text"], input[type="search"] {
  color: var(--theme-text) !important;
  background: var(--theme-panel-strong) !important;
  border-color: var(--theme-border) !important;
}
a { color: var(--theme-text); }

</style>
</head>

<body>
  <canvas id="particleCanvas" aria-hidden="true"></canvas>

  <nav class="sidebar" id="sidebar" aria-label="File navigation">
    <div class="sidebar-top">
      <button class="sidebar-toggle" id="sidebarToggle" type="button"
              aria-label="Expand navigation" aria-expanded="false">☰</button>
      <span class="sidebar-title">NAVIGATION</span>
    </div>
  </nav>

  <main class="main-content">
    <div class="content-wrapper">
      <header class="page-header">
        <div class="eyebrow">The Candy Stash</div>
        <h1>Candy Stash</h1>
        <p class="subtitle">
          Browse and search files from
          <a href="https://docs.google.com/document/d/1_FmH3BlSBQI7FGgAQL59-ZPe8eCxs35wel6JUyVaG8Q/" target="_blank" rel="noopener noreferrer">the Ultimate Game Stash Google Doc</a>.
        </p>
      </header>

      <div class="info-links">
        <span>Community:</span>
        
      </div>

      <section class="search-card" aria-label="File search">
        <div class="search-row">
          <div class="search-box">
            <input id="searchInput" type="search" placeholder="Search files…" autocomplete="off"
                   aria-label="Search files">
            <button class="clear-search" id="clearSearch" type="button" aria-label="Clear search">×</button>
          </div>
          <button id="lolbutton" type="button">↻ Load files</button>
        </div>
        <div class="status" id="searchStatus" role="status" aria-live="polite"></div>
      </section>

      <div id="sections-container">
        <!-- games.js populates this -->
      </div>
    </div>
  </main>

  <script src="https://cdn.jsdelivr.net/gh/bubbls/ugs-singlefile@main/searchbut.js"></script>

  <script>
    (() => {
      const sidebar = document.getElementById("sidebar");
      const toggle = document.getElementById("sidebarToggle");
      const search = document.getElementById("searchInput");
      const clear = document.getElementById("clearSearch");
      const loadButton = document.getElementById("lolbutton");
      const status = document.getElementById("searchStatus");

      toggle.addEventListener("click", () => {
        const expanded = sidebar.classList.toggle("expanded");
        toggle.setAttribute("aria-expanded", String(expanded));
        toggle.setAttribute("aria-label", expanded ? "Collapse navigation" : "Expand navigation");
        toggle.textContent = expanded ? "‹" : "☰";
      });

      // Let the existing search script own the actual filtering.
      // This layer only improves the input UX.
      const updateSearchUI = () => {
        clear.classList.toggle("visible", Boolean(search.value.trim()));
      };
      search.addEventListener("input", updateSearchUI);
      clear.addEventListener("click", () => {
        search.value = "";
        search.dispatchEvent(new Event("input", { bubbles: true }));
        search.focus();
        updateSearchUI();
      });

      loadButton.addEventListener("click", () => {
        if (document.getElementById("game-script")) return;

        loadButton.disabled = true;
        loadButton.textContent = "Loading…";
        status.textContent = "Loading library…";

        const script = document.createElement("script");
        script.id = "game-script";
        script.src = "https://cdn.jsdelivr.net/gh/bubbls/ugs-singlefile@latest/game.js";

        script.onload = () => {
          loadButton.textContent = "✓ Files loaded";
          status.textContent = "Library loaded.";
        };
        script.onerror = () => {
          loadButton.disabled = false;
          loadButton.textContent = "⚠ Retry loading";
          status.textContent = "Could not load the library. Try again.";
          script.remove();
        };
        document.body.appendChild(script);
      });

      // Keep the active alphabet button synchronized with the visible section.
      let activeObserver;
      function setupActiveLetters() {
        const sections = [...document.querySelectorAll(".letter-section")];
        const buttons = [...document.querySelectorAll(".sidebar-btn")];
        if (!sections.length || !buttons.length) return;

        activeObserver?.disconnect();
        activeObserver = new IntersectionObserver((entries) => {
          const visible = entries
            .filter(entry => entry.isIntersecting)
            .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];

          if (!visible) return;
          const id = visible.target.id;
          buttons.forEach(btn => btn.classList.toggle("active", btn.dataset.target === id));
        }, {
          rootMargin: "-15% 0px -70% 0px",
          threshold: [0, .15, .4]
        });

        sections.forEach(section => activeObserver.observe(section));
      }

      const domObserver = new MutationObserver(() => {
        if (document.querySelector(".letter-section") && document.querySelector(".sidebar-btn")) {
          setupActiveLetters();
        }
      });
      domObserver.observe(document.body, { childList: true, subtree: true });

      // Particle background — intentionally lightweight and disabled for reduced motion.
      const canvas = document.getElementById("particleCanvas");
      const ctx = canvas.getContext("2d", { alpha: true });
      const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (!reduceMotion) {
        let w = 0, h = 0, dpr = 1, particles = [];
        const mouse = { x: null, y: null };

        const count = () => innerWidth < 500 ? 20 : innerWidth < 900 ? 32 : 48;

        function resize() {
          dpr = Math.min(devicePixelRatio || 1, 1.5);
          w = innerWidth; h = innerHeight;
          canvas.width = Math.floor(w * dpr);
          canvas.height = Math.floor(h * dpr);
          canvas.style.width = w + "px";
          canvas.style.height = h + "px";
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

          particles = Array.from({ length: count() }, () => ({
            x: Math.random() * w,
            y: Math.random() * h,
            r: Math.random() * 1.6 + .5,
            vx: (Math.random() - .5) * .18,
            vy: (Math.random() - .5) * .18,
            a: Math.random() * .35 + .12
          }));
        }

        addEventListener("resize", resize, { passive: true });
        addEventListener("mousemove", e => { mouse.x = e.clientX; mouse.y = e.clientY; }, { passive: true });
        addEventListener("mouseleave", () => { mouse.x = mouse.y = null; }, { passive: true });

        function frame() {
          ctx.clearRect(0, 0, w, h);
          for (const p of particles) {
            p.x += p.vx; p.y += p.vy;
            if (p.x < -5) p.x = w + 5;
            if (p.x > w + 5) p.x = -5;
            if (p.y < -5) p.y = h + 5;
            if (p.y > h + 5) p.y = -5;

            if (mouse.x !== null) {
              const dx = p.x - mouse.x, dy = p.y - mouse.y;
              const dist = Math.hypot(dx, dy);
              if (dist < 110 && dist > 0) {
                const force = (110 - dist) / 110 * .16;
                p.x += dx / dist * force;
                p.y += dy / dist * force;
              }
            }

            ctx.beginPath();
            ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
            ctx.fillStyle = `rgba(125,166,255,${p.a})`;
            ctx.fill();
          }

          for (let i = 0; i < particles.length; i++) {
            for (let j = i + 1; j < particles.length; j++) {
              const a = particles[i], b = particles[j];
              const d = Math.hypot(a.x - b.x, a.y - b.y);
              if (d < 105) {
                ctx.beginPath();
                ctx.moveTo(a.x, a.y);
                ctx.lineTo(b.x, b.y);
                ctx.strokeStyle = `rgba(109,156,255,${(1 - d / 105) * .075})`;
                ctx.lineWidth = .6;
                ctx.stroke();
              }
            }
          }
          requestAnimationFrame(frame);
        }

        resize();
        frame();
      }
    })();
  </script>

  <script src="https://cdn.jsdelivr.net/gh/bubbls/ugs-singlefile@main/games.js"></script>

<button class="theme-toggle" id="themeToggle" type="button" aria-label="Switch theme">
  <span class="theme-icon" aria-hidden="true">☀️</span>
  <span class="theme-label">Light mode</span>
</button>


<script>
(() => {
  const root = document.documentElement;
  const button = document.getElementById('themeToggle');
  if (!button) return;

  const saved = localStorage.getItem('candy-stash-theme');
  const initial = saved || 'dark';

  const applyTheme = (theme) => {
    root.dataset.theme = theme;
    const light = theme === 'light';
    const icon = button.querySelector('.theme-icon');
    const label = button.querySelector('.theme-label');
    if (icon) icon.textContent = light ? '🌙' : '☀️';
    if (label) label.textContent = light ? 'Dark mode' : 'Light mode';
    button.setAttribute('aria-label', light ? 'Switch to dark mode' : 'Switch to light mode');
  };

  applyTheme(initial);

  button.addEventListener('click', () => {
    const next = root.dataset.theme === 'light' ? 'dark' : 'light';
    localStorage.setItem('candy-stash-theme', next);
    applyTheme(next);
  });
})();
</script>

