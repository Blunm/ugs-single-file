    <!-- =========================================
         UGS UI UPGRADES
    ========================================== -->

    <script>
        (() => {
            const root = document.documentElement;
            const toggle = document.getElementById("themeToggle");

            const savedTheme = localStorage.getItem("ugs-theme");
            if (savedTheme === "light") root.dataset.theme = "light";

            function syncThemeButton() {
                const light = root.dataset.theme === "light";
                toggle.textContent = light ? "☀" : "☾";
                toggle.title = light ? "Switch to dark theme" : "Switch to light theme";
                toggle.setAttribute("aria-label", toggle.title);
            }

            syncThemeButton();

            toggle.addEventListener("click", () => {
                const light = root.dataset.theme === "light";
                if (light) {
                    delete root.dataset.theme;
                    localStorage.setItem("ugs-theme", "dark");
                } else {
                    root.dataset.theme = "light";
                    localStorage.setItem("ugs-theme", "light");
                }
                syncThemeButton();
            });
        })();
    </script>

    <script>
        (() => {
            const sidebar = document.getElementById("sidebar");

            function enhanceNavigation() {
                const sections = [...document.querySelectorAll(".letter-section")];
                const buttons = [...document.querySelectorAll(".sidebar-btn")];

                buttons.forEach(button => {
                    if (!button.querySelector(".nav-letter")) {
                        const raw = button.textContent.trim();
                        button.innerHTML = `
                            <span class="nav-icon">✦</span>
                            <span class="nav-letter">${raw.charAt(0) || "?"}</span>
                            <span class="file-count">0</span>
                        `;
                    }

                    const target = button.dataset.target;
                    const section = target ? document.getElementById(target) : null;
                    const count = section
                        ? section.querySelectorAll('input[type="button"], .file-button').length
                        : 0;

                    const badge = button.querySelector(".file-count");
                    if (badge) badge.textContent = count;
                    button.setAttribute("aria-label",
                        `${button.querySelector(".nav-letter")?.textContent || "Letter"} — ${count} files`);
                });

                // Keep the moving neon rail aligned with the active letter.
                const active = buttons.find(b => b.classList.contains("active"));
                if (active) {
                    const sidebarRect = sidebar.getBoundingClientRect();
                    const buttonRect = active.getBoundingClientRect();
                    sidebar.style.setProperty(
                        "--indicator-y",
                        `${buttonRect.top - sidebarRect.top + (buttonRect.height - 56) / 2}px`
                    );
                }
            }

            const observer = new MutationObserver(enhanceNavigation);
            observer.observe(sidebar, { childList: true, subtree: true, attributes: true, attributeFilter: ["class"] });

            window.addEventListener("scroll", enhanceNavigation, { passive: true });
            window.addEventListener("resize", enhanceNavigation);
            setTimeout(enhanceNavigation, 150);
        })();
